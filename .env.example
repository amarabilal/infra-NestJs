# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=tournament_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Synchronisation du schéma DB
# Mettre à true au premier lancement en production pour créer les tables
# Laisser vide ou false ensuite
DB_SYNCHRONIZE=
